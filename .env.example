# Copy to .env and fill in. Never commit .env — it is in .gitignore.

# Pick ONE provider and set COURSE_PROVIDER to match: anthropic | openai | google
COURSE_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

TAVILY_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=session-4-eval-pipeline
